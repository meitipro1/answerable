# Optional: override the contract (defaults to web/lib/deployed.json)
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Optional: point the footer and rubric links at a fork
NEXT_PUBLIC_GITHUB_URL=
# Optional preview verdict in the desk composer (server only, never NEXT_PUBLIC)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Base URL must not end in /v1; the route appends /v1/chat/completions
OPENROUTER_BASE_URL=https://openrouter.ai/api
